# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://kngo:changeme@localhost:5432/kngo_seo"

# Docker Compose only
POSTGRES_PASSWORD="changeme"

# ─── NextAuth (v5) ──────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Set to "true" only when running behind a TLS-terminating reverse proxy
# (Coolify/Traefik, Cloudflare). Cookies will then be issued without the
# Secure flag so the proxy's HTTP backconnection works. Leave unset in dev.
AUTH_INSECURE_COOKIES="false"
# Verbose NextAuth logging (do not enable in production).
AUTH_DEBUG="false"

# ─── Encryption ─────────────────────────────────────────
# 32-byte key (hex) used to encrypt sensitive per-client credentials at rest
# (currently: WordPress Application Passwords). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ─── DataForSEO ─────────────────────────────────────────
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# ─── Anthropic (Claude AI) ──────────────────────────────
ANTHROPIC_API_KEY=""
# Optional: override the model. Defaults to current Sonnet (claude-sonnet-4-6).
# Set to a specific snapshot if you need to pin a version.
ANTHROPIC_MODEL=""

# ─── GoHighLevel ────────────────────────────────────────
GHL_API_KEY=""
GHL_LOCATION_ID=""

# ─── Mailgun (Transactional Email) ──────────────────────
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM_EMAIL="KNGO SEO <notifications@kangomedia.com>"
