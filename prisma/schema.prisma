generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ─────────────────────────────────────────────

enum UserRole {
  AGENCY_ADMIN
  AGENCY_MEMBER
  CLIENT
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  role           UserRole  @default(CLIENT)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  clientAccess   ClientUser[]
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Clients ──────────────────────────────────────────

enum ClientTier {
  STARTER
  GROWTH
  PRO
}

model Client {
  id          String     @id @default(cuid())
  name        String
  domain      String?
  logoUrl     String?
  tier        ClientTier @default(STARTER)
  isActive    Boolean    @default(true)
  accessToken String     @unique @default(uuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Contact / Business info
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  city         String?
  state        String?
  zip          String?
  notes        String?

  // Google Business Profile
  gbpName      String?   // GBP listing name
  gbpUrl       String?   // GBP profile URL (maps.google.com link)
  gbpPhone     String?   // GBP phone number
  gbpAddress   String?   // GBP listed address
  gbpCategory  String?   // Primary GBP category

  // Deliverable template defaults (Local Visibility tier defaults)
  monthlyBlogs             Int @default(2)
  monthlyGbpPosts          Int @default(2)
  monthlyGbpQAs            Int @default(2)
  monthlyPressReleases     Int @default(1)
  monthlyDirectoryListings Int @default(25)
  includesAudit            Boolean @default(true)
  includesReporting        Boolean @default(true)

  // Google Integration
  gscProperty   String?  // GSC property URL (e.g. "sc-domain:example.com")
  ga4PropertyId String?  // GA4 property ID (e.g. "123456789")

  // SEO Configuration
  sitemapUrl    String?  // Custom sitemap URL (defaults to /sitemap.xml if blank)

  // Onboarding
  onboardingStatus  String?  @default("PENDING")  // PENDING, DISCOVERING, COMPLETE
  serviceAreas      String?  @db.Text              // JSON array: geographic regions (e.g. ["Northern Colorado", "Denver Metro"]). NOT a duplicate of primaryServices.
  targetCities      String?  @db.Text              // JSON array: ["McAllen, TX", "Mission, TX"]
  competitors       String?  @db.Text              // DEPRECATED — use Competitor table. Kept for backward-compat reads.
  icpPains          String?  @db.Text              // JSON array of pain points the ICP feels (drives pain-point keyword research)

  // Business Profile (for AI keyword targeting)
  businessDescription  String?  @db.Text  // "Custom website development for contractors $10K+"
  primaryServices      String?  @db.Text  // JSON array: ["custom websites", "web apps", "SEO"]
  idealClientProfile   String?  @db.Text  // "Large contractor companies, $5M+ revenue"
  priceRange           String?            // "budget", "mid-range", "premium", "enterprise"
  industryVertical     String?            // "Construction", "Medical", "Legal" etc.

  // WordPress Publishing
  wpUrl              String?  // e.g. "https://example.com" (no trailing slash)
  wpUsername         String?  // WP user with author/editor privileges
  wpAppPasswordEnc   String?  @db.Text  // AES-256-GCM encrypted Application Password (format: iv:tag:ciphertext, hex)

  // Performance / ROI configuration
  brandTerms         String?  @db.Text   // JSON array of branded query terms; if null, derived from name/domain
  avgCpcUsd          Float    @default(3.50)  // dollars; multiplied by clicks for estimated traffic value

  // Relations
  users              ClientUser[]
  keywords           Keyword[]
  rankSnapshots      RankSnapshot[]
  contentPlans       ContentPlan[]
  deliverables       Deliverable[]
  reports            Report[]
  siteAudits         SiteAudit[]
  googleToken        GoogleToken?
  keywordResearch    KeywordResearch[]
  contentMaps        ContentMap[]
  urlCrawls          UrlCrawl[]
  monthlySnapshots   MonthlySnapshot[]
  competitorEntries  Competitor[]
}

model ClientUser {
  id       String @id @default(cuid())
  userId   String
  clientId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
}

// ─── Rankings ─────────────────────────────────────────

model Keyword {
  id           String   @id @default(cuid())
  clientId     String
  keyword      String
  searchVolume Int?
  difficulty   Int?
  cpc          Float?   // USD; from DataForSEO Google Ads — refreshed when metrics update
  targetUrl    String?
  group        String?  // keyword group/cluster name
  isTracking   Boolean  @default(true)
  createdAt    DateTime @default(now())

  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  snapshots RankSnapshot[]

  @@unique([clientId, keyword])
}

model RankSnapshot {
  id          String   @id @default(cuid())
  clientId    String
  keywordId   String
  position    Int?     // null = not ranking
  previousPos Int?
  url         String?  // the URL that's ranking
  localPack   Boolean  @default(false)
  checkedAt   DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([clientId, checkedAt])
  @@index([keywordId, checkedAt])
}

// ─── Keyword Research ─────────────────────────────────

model KeywordResearch {
  id            String   @id @default(cuid())
  clientId      String
  mode          String   @default("SERVICE")  // SERVICE | PAIN_POINT | MIXED
  pillarSlug    String?  // optional — researched specifically for a pillar
  seedTopics    String   @db.Text  // comma-separated seed topics used
  location      String   @default("United States")
  results       String   @db.Text  // JSON: array of discovered keywords with metrics + ROI
  aiAnalysis    String?  @db.Text  // Claude's strategic analysis and recommendations
  keywordsFound Int      @default(0)
  createdAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

// ─── Content Maps ─────────────────────────────────────

model ContentMap {
  id         String   @id @default(cuid())
  clientId   String
  title      String   // e.g. "Q2 2026 Content Strategy"
  mapData    String   @db.Text  // JSON: pillar topics, supporting content, keyword clusters
  aiSummary  String?  @db.Text  // Claude's strategic summary
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ─── Content ──────────────────────────────────────────

enum ContentType {
  BLOG_POST
  GBP_POST
  GBP_QA
  PRESS_RELEASE
}

enum ContentStatus {
  PLANNED
  CLIENT_REVIEW
  APPROVED
  REJECTED
  WRITING
  DRAFT_REVIEW       // client reviewing final draft
  READY_TO_PUBLISH   // draft approved, awaiting publish
  PUBLISHED
  ARCHIVED
}

model ContentPlan {
  id          String   @id @default(cuid())
  clientId    String
  month       Int      // 1-12
  year        Int
  title       String   // e.g. "May 2026 Content Plan"
  seedKeyword String?
  planStatus  String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  planNotes   String?  @db.Text // Client feedback notes on plan
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pieces ContentPiece[]

  @@unique([clientId, month, year])
}

model ContentPiece {
  id            String        @id @default(cuid())
  contentPlanId String
  type          ContentType
  title         String
  description   String?       @db.Text  // angle/brief
  keyword       String?       // target keyword
  body          String?       @db.Text  // full content body (markdown/html)
  status        ContentStatus @default(PLANNED)
  sortOrder     Int           @default(0)
  priority      Int           @default(0)  // higher = more urgent in queue
  revisionCount Int           @default(0)  // tracks revision cycles
  isReserve     Boolean       @default(false) // backup piece — only shown if client rejects a primary
  dueDate            DateTime?   // writing deadline
  scheduledPublishDate DateTime? // target publish date
  publishedUrl  String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  contentPlan ContentPlan      @relation(fields: [contentPlanId], references: [id], onDelete: Cascade)
  approval    ContentApproval?
}

model ContentApproval {
  id             String   @id @default(cuid())
  contentPieceId String   @unique
  outcome        String   // 'approved', 'rejected', 'save_for_later'
  notes          String?  @db.Text
  imageUrl       String?  // reference photo from client
  decidedAt      DateTime @default(now())

  contentPiece ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
}

// ─── Deliverables ─────────────────────────────────────

enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model Deliverable {
  id          String            @id @default(cuid())
  clientId    String
  month       Int
  year        Int
  name        String            // "Blog Posts", "GBP Posts", "Technical Audit", etc.
  targetCount Int               @default(1)
  currentCount Int              @default(0)
  status      DeliverableStatus @default(PENDING)
  notes       String?           @db.Text
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, month, year, name])
  @@index([clientId, month, year])
}

// ─── Reports ──────────────────────────────────────────

model Report {
  id          String   @id @default(cuid())
  clientId    String
  uuid        String   @unique @default(cuid()) // public share link
  type        String   @default("MONTHLY")       // MONTHLY, SITE_AUDIT, BASELINE
  month       Int
  year        Int
  title       String
  summary     String?  @db.Text // plain English summary
  highlights  String?  @db.Text // JSON array of key wins
  pdfUrl      String?
  isPublished Boolean  @default(false)
  isArchived  Boolean  @default(false)
  expiresAt   DateTime? // public link expiration; null = no expiry
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, month, year])
}

// ─── Settings ─────────────────────────────────────────

model AgencySettings {
  id              String  @id @default("default")
  agencyName      String  @default("KangoMedia")
  logoUrl         String?
  dataforseoLogin String?
  dataforseoPwd   String?
  claudeApiKey    String?
  ghlApiKey       String?
  ghlLocationId   String?
}

// ─── Site Audit (On-Page SEO) ─────────────────────────

model SiteAudit {
  id          String    @id @default(cuid())
  clientId    String
  taskId      String?   // DataForSEO task ID
  status      String    @default("PENDING") // PENDING, CRAWLING, COMPLETED, FAILED
  pagesCount  Int       @default(0)
  onpageScore Float?    // 0-100 overall health score
  summary     String?   @db.Text // JSON: full crawl summary
  crawledAt   DateTime  @default(now())
  archivedAt  DateTime? // null = active, set = archived

  client Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pages  SiteAuditPage[]

  @@index([clientId, crawledAt])
}

model SiteAuditPage {
  id              String @id @default(cuid())
  auditId         String
  url             String
  statusCode      Int?
  title           String?
  description     String?  @db.Text
  h1Count         Int      @default(0)
  wordCount       Int      @default(0)
  imageCount      Int      @default(0)
  imagesNoAlt     Int      @default(0)
  checks          String?  @db.Text // JSON: per-page check results
  onpageScore     Float?
  recommendations String?  @db.Text // JSON: AI-generated recs per check
  excludedFromReport Boolean @default(false) // Hide from client-facing reports

  audit  SiteAudit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  issues AuditIssue[]

  @@index([auditId])
}

model AuditIssue {
  id            String   @id @default(cuid())
  pageId        String
  checkKey      String   // e.g. "no_title", "title_too_long"
  severity      String   @default("warning") // "critical", "warning", "info"
  currentValue  String?  @db.Text // e.g. current title text
  suggestion    String?  @db.Text // AI-generated replacement
  status        String   @default("OPEN") // OPEN, FIXED, IGNORED
  fixedAt       DateTime?
  fixNotes      String?  @db.Text
  createdAt     DateTime @default(now())

  page SiteAuditPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([status])
}

// ─── Google Integration ───────────────────────────────

model GoogleToken {
  id           String   @id @default(cuid())
  clientId     String   @unique
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─── CPC cache ────────────────────────────────────────
// DataForSEO Google Ads CPC values cached so we don't re-pay for the same
// query each month. Looked up by (query, locationCode). Refresh policy:
// stale after 30 days. Used by traffic-value calc — see src/lib/cpc-cache.ts.

model KeywordCpc {
  id           String   @id @default(cuid())
  keyword      String
  locationCode Int      // DataForSEO location code (e.g. 2840 = US)
  cpc          Float?   // USD; null = DataForSEO returned no CPC for this query
  competition  Float?
  searchVolume Int?
  fetchedAt    DateTime @default(now())

  @@unique([keyword, locationCode])
  @@index([fetchedAt])
}

// ─── Monthly Performance Snapshots ────────────────────
// Persists month-end aggregates so historical trends survive even if upstream
// APIs (GSC, GA4) are reconfigured. Filled by a monthly cron + on-demand
// "Generate Report" path. One row per client per month.

model MonthlySnapshot {
  id                String   @id @default(cuid())
  clientId          String
  month             Int      // 1-12
  year              Int

  // GSC totals (full calendar month)
  gscClicks            Int      @default(0)
  gscImpressions       Int      @default(0)
  gscBrandedClicks     Int      @default(0)
  gscNonBrandedClicks  Int      @default(0)
  gscAvgPosition       Float?

  // GA4 totals
  ga4Sessions          Int      @default(0)
  ga4Users             Int      @default(0)
  ga4OrganicSessions   Int      @default(0)
  ga4PageViews         Int      @default(0)

  // Engagement / intent signals (from GA4 events)
  phoneClicks          Int      @default(0)
  formSubmits          Int      @default(0)
  emailClicks          Int      @default(0)

  // Estimated traffic value: nonBrandedClicks * avgCpcUsd (dollars)
  estTrafficValue      Float    @default(0)
  cpcUsedUsd           Float    @default(0)  // CPC value used for the calc, frozen at snapshot time

  // Raw drill-down data (JSON arrays)
  pageData             String?  @db.Text  // [{url, clicks, impressions, ctr, position}]
  queryData            String?  @db.Text  // [{query, clicks, impressions, ctr, position, isBranded}]

  generatedAt          DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, month, year])
  @@index([clientId, year, month])
}

// ─── Competitor Discovery ─────────────────────────────
// Replaces the legacy Client.competitors JSON array with structured rows
// that carry classification metadata. PEER rows where isAccepted=true are
// the working set used by keyword research (legacy `Client.competitors`
// reads still work but new code should query this table).

model Competitor {
  id             String   @id @default(cuid())
  clientId       String
  domain         String
  // Classification mirrors what the discovery prompt outputs:
  //   PEER          — same business model + similar tier (real competition)
  //   PLATFORM      — DIY tool clients use INSTEAD of an agency (Wix, GoDaddy, Squarespace)
  //   DIRECTORY     — listing/aggregator (Yelp, Clutch, UpCity)
  //   MARKETPLACE   — freelancer/job platform (Fiverr, Upwork)
  //   TIER_MISMATCH — same model, different tier (national giants for a local agency)
  //   ADJACENT      — different category but related (SaaS vendors for an agency)
  //   IRRELEVANT    — wrong category entirely
  classification String   @default("PEER")
  reasoning      String?  @db.Text         // one-sentence rationale from Claude
  pillarSlug     String?                   // optional — relevant only to a specific pillar
  isAccepted     Boolean  @default(true)   // included in research scrapes when true
  source         String   @default("manual")  // 'manual' | 'discovery' | 'wizard'
  domainRank     Int?                      // Optional: DR/DA snapshot at discovery
  estTraffic     Int?                      // Optional: est monthly organic traffic
  discoveredAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, domain])
  @@index([clientId, isAccepted])
  @@index([clientId, classification])
}

// ─── Domain Migration / URL Crawl ─────────────────────

model UrlCrawl {
  id          String    @id @default(cuid())
  clientId    String?
  domain      String
  taskId      String?   // DataForSEO On-Page task ID
  status      String    @default("PENDING") // PENDING, CRAWLING, COMPLETED, FAILED
  pagesCount  Int       @default(0)
  maxPages    Int       @default(500)
  label       String?   // User label e.g. "Domain A - old site"
  urls        String?   @db.Text  // JSON array of crawled URL objects
  createdAt   DateTime  @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([createdAt])
}
